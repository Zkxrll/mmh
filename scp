                        local base = CosmeticLibrary.Cosmetics[cn]
                        if base then
                            local cl = {}
                            for k, v in pairs(base) do cl[k] = v end
                            cl.Name = cn
                            cl.Seed = math.random(1, 1e6)
                            if iw then cl.Type = "Wrap" end
