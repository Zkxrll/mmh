local function loadMasterData()
    local ok, raw = pcall(readfile, SAVE_FILE)
    if ok and raw and raw ~= "" then
        local ok2, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok2 and type(decoded) == "table" then
            if decoded.Settings       then MasterData.Settings        = decoded.Settings       end
            if decoded.Profiles       then MasterData.Profiles        = decoded.Profiles       end
            if decoded.CurrentProfile then MasterData.CurrentProfile  = decoded.CurrentProfile end
        end
    end
end

