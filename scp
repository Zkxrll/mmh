-- AIMBOT UI  (MacLib section — controls only)
-- ============================================================
do
    local Aim = getgenv().ZkxAimbot and getgenv().ZkxAimbot.State
    if not Aim then
        Window:Notify({ Title = "Aimbot", Description = "Engine not loaded — check Part 1 is above line 462.", Lifetime = 5 })
        return
    end

    local aimTab   = tabs.Aimbot
    local aimLeft  = aimTab:Section({ Side = "Left"  })
    local aimRight = aimTab:Section({ Side = "Right" })

    aimLeft:Header({ Text = "Aimbot" })

    aimLeft:Toggle({
        Name    = "Enabled",
        Default = Aim.Enabled,
        Callback = function(v) Aim.Enabled = v end,
    })

    aimLeft:Slider({
        Name          = "Prediction",
        Default       = Aim.Prediction,
        Minimum       = 0,
        Maximum       = 1,
        DisplayMethod = "Hundredths",
        Callback      = function(v) Aim.Prediction = v end,
    })

    aimRight:Header({ Text = "FOV" })

    aimRight:Toggle({
        Name    = "Show FOV Circle",
        Default = Aim.ShowFOV,
        Callback = function(v) Aim.ShowFOV = v end,
    })

    aimRight:Slider({
        Name          = "FOV Size",
        Default       = Aim.FOV,
        Minimum       = 20,
        Maximum       = 500,
        DisplayMethod = "Round",
        Callback      = function(v) Aim.FOV = v end,
    })

    aimRight:Toggle({
        Name    = "Team Check",
        Default = Aim.TeamCheck,
        Callback = function(v) Aim.TeamCheck = v end,
    })

    aimLeft:Dropdown({
        Name    = "Aim Mode",
        Options = { "Hold", "Toggle", "Always" },
        Default = Aim.Mode,
        Callback = function(val)
            Aim.Mode    = type(val) == "table" and val[1] or val
            -- reset activation flags when switching modes so it can't get stuck on
            Aim.Holding = false
            Aim.Toggled = false
        end,
    })

    local aimKeyBtn
    aimKeyBtn = aimLeft:Button({
        Name = "Aim Key: " .. (Aim.KeyName or "None"),
        Callback = function()
            Aim.Listening   = true
            Aim.ListenStart = os.clock()
            pcall(function() aimKeyBtn:UpdateName("Aim Key: [ press key / mouse ]") end)
        end,
    })
    Aim.OnRebind = function(name)
        pcall(function() aimKeyBtn:UpdateName("Aim Key: " .. name) end)
    end
end

