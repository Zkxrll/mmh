local menuVisible = true

local function setWindowVisible(state)
    menuVisible = state
    -- MacLib exposes a few names across versions; try them all, fall back to gui toggle
    local ok = pcall(function()
        if state then Window:Open() else Window:Close() end
    end)
    if not ok then
        pcall(function() Window:SetVisibility(state) end)
    end
    if not ok then
        pcall(function() Window:Toggle() end)
    end
end

