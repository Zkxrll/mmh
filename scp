    aimBtn.BackgroundColor3  = Color3.fromRGB(28, 28, 32)
    aimBtn.BackgroundTransparency = 0.2
    aimBtn.TextColor3        = Color3.fromRGB(240, 240, 245)
    aimBtn.Font              = Enum.Font.GothamBold
    aimBtn.TextSize          = 15
    aimBtn.Text              = "AIM"
    aimBtn.AutoButtonColor   = false
    aimBtn.Visible           = false
    aimBtn.Parent            = aimBtnGui
    local abCorner = Instance.new("UICorner")
    abCorner.CornerRadius = UDim.new(1, 0)
    abCorner.Parent       = aimBtn
    local abStroke = Instance.new("UIStroke")
    abStroke.Color     = Color3.fromRGB(80, 80, 90)
    abStroke.Thickness = 1
    abStroke.Parent    = aimBtn

    aimBtn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if Aim.Mode == "Hold" then
            Aim.Holding = true
        elseif Aim.Mode == "Toggle" then
            Aim.Toggled = not Aim.Toggled
        end
    end)
    aimBtn.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if Aim.Mode == "Hold" then
            Aim.Holding = false
        end
    end)

    -- ---- PC key input: hold-tracking + toggle-flip on the bound key ----
    -- ---- input identity: normalizes keyboard keys AND mouse buttons ----
    -- Build the mouse map dynamically: MouseButton4/5 don't exist on stock
    -- Roblox and referencing them directly would crash, so probe first and
    -- only add whatever the client/executor actually exposes.
    local MOUSE_NAMES = {}
    for _, name in ipairs({ "MouseButton1", "MouseButton2", "MouseButton3", "MouseButton4", "MouseButton5" }) do
        local ok, enumItem = pcall(function() return Enum.UserInputType[name] end)
        if ok and enumItem then
            MOUSE_NAMES[enumItem] = name
        end
    end

    local function inputIdentity(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                return input.KeyCode, input.KeyCode.Name
            end
        elseif MOUSE_NAMES[input.UserInputType] then
            return input.UserInputType, MOUSE_NAMES[input.UserInputType]
        end
        return nil
    end
    local function matchesBind(input)
        local id = inputIdentity(input)
        return id ~= nil and id == Aim.Key
    end

    -- ---- key/mouse input: rebind capture + hold-track + toggle-flip ----
    local kbBegan = UserInputService.InputBegan:Connect(function(input, gpe)
        -- rebinding: capture the next key or mouse button as the new aim bind
        if Aim.Listening then
            if os.clock() - Aim.ListenStart < 0.2 then return end -- skip the click that opened rebinding
            local id, name = inputIdentity(input)
            if id then
                Aim.Key, Aim.KeyName, Aim.Listening = id, name, false
                if Aim.OnRebind then pcall(Aim.OnRebind, name) end
            end
            return
        end
        -- only let gameProcessed block KEYBOARD (so typing in the menu won't fire);
        -- mouse buttons must work even while the camera is processing them
        if gpe and input.UserInputType == Enum.UserInputType.Keyboard then return end
        if not matchesBind(input) then return end
        if Aim.Mode == "Hold" then
            Aim.Holding = true
        elseif Aim.Mode == "Toggle" then
            Aim.Toggled = not Aim.Toggled
        end
    end)
    local kbEnded = UserInputService.InputEnded:Connect(function(input)
        if not matchesBind(input) then return end
        if Aim.Mode == "Hold" then
            Aim.Holding = false
        end
    end)

    -- ---- targeting helpers ----
    local function getAimOrigin()
        if UserInputService.MouseEnabled then
            return UserInputService:GetMouseLocation()
        end
        local vp = workspace.CurrentCamera.ViewportSize
        return Vector2.new(vp.X / 2, vp.Y / 2)
    end

    local function getTargetPart(char)
        return char:FindFirstChild("Head")
            or char:FindFirstChild("HumanoidRootPart")
            or char.PrimaryPart
    end

    local function isValidTarget(plr)
        if plr == LocalPlayer then return false end
        if Aim.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
            return false
        end
        local char = plr.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return false end
        return true
    end

    local function getClosestTarget()
        local camera = workspace.CurrentCamera
        local origin = getAimOrigin()
        local camPos = camera.CFrame.Position
        local best, bestDist, bestPredicted = nil, Aim.FOV, nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if isValidTarget(plr) then
                local part = getTargetPart(plr.Character)
                if part then
                    local worldDist = (part.Position - camPos).Magnitude
                    if worldDist <= Aim.MaxDistance then
                        local predicted = part.Position + (part.AssemblyLinearVelocity * Aim.Prediction)
                        local sp = camera:WorldToViewportPoint(predicted)
                        if sp.Z > 0 then
                            local screenPos  = Vector2.new(sp.X, sp.Y)
                            local screenDist = (screenPos - origin).Magnitude
                            if screenDist <= bestDist then
                                best, bestDist, bestPredicted = part, screenDist, predicted
                            end
                        end
                    end
                end
            end
        end
        return best, bestPredicted
    end

    -- ---- main loop ----
local conn = RunService.RenderStepped:Connect(function()
        if Aim.ShowFOV and Aim.Enabled then
            local o = getAimOrigin()
            ring.Visible  = true
            ring.Size     = UDim2.fromOffset(Aim.FOV * 2, Aim.FOV * 2)
            ring.Position = UDim2.fromOffset(o.X, o.Y)
        else
            ring.Visible = false
        end

        local wantBtn = Aim.Enabled and Aim.Mode ~= "Always"
            and UserInputService.TouchEnabled
        aimBtn.Visible = wantBtn
        local on = aimActive()
        aimBtn.BackgroundColor3 = on
            and Color3.fromRGB(40, 120, 60)
            or  Color3.fromRGB(28, 28, 32)

        if not on then return end

        local _part, predicted = getClosestTarget()
        if not predicted then return end

        local camera = workspace.CurrentCamera

        -- desktop: move the OS cursor to the target so mouse-look can't fight the lock
        if UserInputService.MouseEnabled and mousemoverel then
            local sp = camera:WorldToViewportPoint(predicted)
            if sp.Z <= 0 then return end
            local origin    = getAimOrigin()
            local targetPos = Vector2.new(sp.X, sp.Y)
            local move      = targetPos - origin
            if move.Magnitude > 0.5 then
                pcall(mousemoverel, move.X, move.Y)
            end
        else
            -- mobile fallback: rotate the camera directly
            camera.CFrame = CFrame.new(camera.CFrame.Position, predicted)
        end
    end)

    getgenv().ZkxAimbot = {
        State   = Aim,
        Cleanup = function()
            if conn then conn:Disconnect() end
            if kbBegan then kbBegan:Disconnect() end
            if kbEnded then kbEnded:Disconnect() end
            if fovGui then fovGui:Destroy() end
            if aimBtnGui then aimBtnGui:Destroy() end
        end,
    }
end

