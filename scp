task.spawn(function()
    if not game:IsLoaded() then game.Loaded:Wait() end
    if game.GameId ~= 6035872082 then warn("Wrong game"); return end

    local i = 0
    for _, v in getgc() do
        i += 1
        if i % 100 == 0 then task.wait() end  -- yield more often

        local t = typeof(v)

        if t == "thread" then
            -- Skip dead threads entirely — no point checking or cancelling them
            if coroutine.status(v) ~= "dead" then
                local ok, src = pcall(debug.info, v, 1, "s")
                if ok and type(src) == "string" and src:find("AnalyticsPipelineController") then
                    pcall(task.cancel, v)
                end
            end

        elseif t == "function" then
            local ok, src = pcall(debug.info, v, "s")
            if ok and type(src) == "string" and src:find("AnalyticsPipelineController") then
                pcall(hookfunction, v, newcclosure(function() return task.wait(9e9) end))
            end
        end
    end

    -- Null the remote
    local ok, remote = pcall(function()
        return game:GetService("ReplicatedStorage")
            .Remotes.AnalyticsPipeline.RemoteEvent.OnClientEvent
    end)
    if ok and remote then
        local ok2, conns = pcall(getconnections, remote)
        if ok2 then
            for _, conn in ipairs(conns) do
                if conn.Function then
                    pcall(hookfunction, conn.Function, newcclosure(function() end))
                end
            end
        end
    end

    print("[ACB] Done")
end)

