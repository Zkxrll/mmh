-- ESP ENGINE  (main script — all logic, no UI)
-- ============================================================
do
    local Players    = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    if getgenv().ZkxESP and getgenv().ZkxESP.Cleanup then
        pcall(getgenv().ZkxESP.Cleanup)
    end

    local ESP = {
        Enabled     = false,
        Box         = true,
        Name        = true,
        Distance    = true,
        HealthBar   = true,
        Tracer      = false,
        Chams       = true,
        TeamCheck   = true,
        TeamColor   = false,
        MaxDistance = 1000,
        Color       = Color3.fromRGB(255, 60, 60),
    }

    local pg = LocalPlayer:WaitForChild("PlayerGui")
    local gui = Instance.new("ScreenGui")
    gui.Name           = "ZkxESP"
    gui.ResetOnSpawn   = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder   = 9996
    gui.Parent         = pg

    local objects = {} -- [player] = { box, name, dist, hpBg, hpFill, tracer, highlight }

    -- ---- helpers ----
    local function makeFrame(parent, stroke)
        local f = Instance.new("Frame")
        f.BackgroundTransparency = stroke and 1 or 0
        f.BorderSizePixel = 0
        f.Visible = false
        f.Parent = parent
        if stroke then
            local s = Instance.new("UIStroke")
            s.Thickness = 1
            s.Color = Color3.new(1, 1, 1)
            s.Parent = f
        end
        return f
    end

    local function makeLabel(parent)
        local t = Instance.new("TextLabel")
        t.BackgroundTransparency = 1
        t.Font = Enum.Font.GothamBold
        t.TextSize = 13
        t.TextStrokeTransparency = 0.4
        t.TextColor3 = Color3.new(1, 1, 1)
        t.Visible = false
        t.Parent = parent
        return t
    end

    local function createObjects(plr)
        local box = makeFrame(gui, true)
        local o = {
            box      = box,
            name     = makeLabel(gui),
            dist     = makeLabel(gui),
            hpBg     = makeFrame(gui, false),
            hpFill   = makeFrame(gui, false),
            tracer   = makeFrame(gui, false),
            highlight= nil,
        }
        o.hpBg.BackgroundColor3   = Color3.fromRGB(0, 0, 0)
        o.hpBg.BackgroundTransparency = 0.35
        o.tracer.BackgroundColor3 = Color3.new(1, 1, 1)
        o.tracer.AnchorPoint      = Vector2.new(0.5, 2)
        return o
    end

    local function hideAll(o)
        o.box.Visible, o.name.Visible, o.dist.Visible = false, false, false
        o.hpBg.Visible, o.hpFill.Visible, o.tracer.Visible = false, false, false
        if o.highlight then o.highlight.Enabled = false end
    end

    local function colorFor(plr)
        if ESP.TeamColor and plr.Team then return plr.TeamColor.Color end
        return ESP.Color
    end

    local function isEnemy(plr)
        if not ESP.TeamCheck then return true end
        if plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return false end
        return true
    end

    -- ---- main loop ----
    local conn = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if not camera then return end
        local vp = camera.ViewportSize

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local o = objects[plr]
                if not o then o = createObjects(plr); objects[plr] = o end

                local char = plr.Character
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                local head = char and char:FindFirstChild("Head")

                local show = ESP.Enabled and hrp and hum and hum.Health > 0 and isEnemy(plr)
                if show then
                    local camPos    = camera.CFrame.Position
                    local worldDist = (hrp.Position - camPos).Magnitude
                    show = worldDist <= ESP.MaxDistance
                    if show then
                        local col = colorFor(plr)
                        -- project a top and bottom point for the 2D box
                        local topW = (head and head.Position or hrp.Position) + Vector3.new(0, 1.5, 0)
                        local botW = hrp.Position - Vector3.new(0, 3.0, 0)
                        local top = camera:WorldToViewportPoint(topW)
                        local bot = camera:WorldToViewportPoint(botW)
                        if top.Z > 0 and bot.Z > 0 then
                            local height  = math.abs(top.Y - bot.Y)
                            local width   = height * 0.55
                            local centerX = top.X
                            local left    = centerX - width / 2
                            local topY    = math.min(top.Y, bot.Y)

                            -- Box
                            if ESP.Box then
                                o.box.Position = UDim2.fromOffset(left, topY)
                                o.box.Size     = UDim2.fromOffset(width, height)
                                o.box:FindFirstChildOfClass("UIStroke").Color = col
                                o.box.Visible  = true
                            else o.box.Visible = false end

                            -- Name
                            if ESP.Name then
                                o.name.Text     = plr.DisplayName ~= "" and plr.DisplayName or plr.Name
                                o.name.TextColor3 = col
                                o.name.Size     = UDim2.fromOffset(width + 60, 16)
                                o.name.Position = UDim2.fromOffset(centerX - (width + 60) / 2, topY - 18)
                                o.name.Visible  = true
                            else o.name.Visible = false end

                            -- Distance
                            if ESP.Distance then
                                o.dist.Text     = ("%dm"):format(worldDist)
                                o.dist.TextColor3 = col
                                o.dist.Size     = UDim2.fromOffset(width + 60, 14)
                                o.dist.Position = UDim2.fromOffset(centerX - (width + 60) / 2, topY + height + 2)
                                o.dist.Visible  = true
                            else o.dist.Visible = false end

                            -- Health bar (left side, green->red)
                            if ESP.HealthBar then
                                local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                                o.hpBg.Position = UDim2.fromOffset(left - 6, topY)
                                o.hpBg.Size     = UDim2.fromOffset(3, height)
                                o.hpBg.Visible  = true
                                o.hpFill.AnchorPoint = Vector2.new(0, 1)
                                o.hpFill.Position    = UDim2.fromOffset(left - 6, topY + height)
                                o.hpFill.Size        = UDim2.fromOffset(3, height * pct)
                                o.hpFill.BackgroundColor3 = Color3.fromRGB(
                                    math.floor(255 * (1 - pct)), math.floor(255 * pct), 40)
                                o.hpFill.Visible = true
                            else o.hpBg.Visible, o.hpFill.Visible = false, false end

                        	 -- Tracer (from bottom-center of screen to box bottom)
                            if ESP.Tracer then
                                local from = Vector2.new(vp.X / 2, vp.Y)
                                local to   = Vector2.new(centerX, topY + height)
                                local diff = to - from
                                o.tracer.Position = UDim2.fromOffset(from.X, from.Y)
                                o.tracer.Size     = UDim2.fromOffset(diff.Magnitude, 1)
                                o.tracer.Rotation = math.deg(math.atan2(diff.Y, diff.X))
                                o.tracer.BackgroundColor3 = col
                                o.tracer.Visible  = true
                            else o.tracer.Visible = false end
                        else
                            o.box.Visible, o.name.Visible, o.dist.Visible = false, false, false
                            o.hpBg.Visible, o.hpFill.Visible, o.tracer.Visible = false, false, false
                        end

                        -- Chams (Highlight — native, shows through walls, works on mobile)
                        if ESP.Chams then
                            if not o.highlight then
                                o.highlight = Instance.new("Highlight")
                                o.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                o.highlight.FillTransparency = 0.6
                                o.highlight.OutlineTransparency = 0
                                o.highlight.Parent = gui
                            end
                            o.highlight.Adornee = char
                            o.highlight.FillColor = col
                            o.highlight.OutlineColor = col
                            o.highlight.Enabled = true
                        elseif o.highlight then
                            o.highlight.Enabled = false
                        end
                    else hideAll(o) end
                else
                    hideAll(o)
                end
            end
        end
    end)

    local removing = Players.PlayerRemoving:Connect(function(plr)
        local o = objects[plr]
        if o then
            pcall(function() o.box:Destroy() end)
            pcall(function() o.name:Destroy() end)
            pcall(function() o.dist:Destroy() end)
            pcall(function() o.hpBg:Destroy() end)
            pcall(function() o.hpFill:Destroy() end)
            pcall(function() o.tracer:Destroy() end)
            if o.highlight then pcall(function() o.highlight:Destroy() end) end
            objects[plr] = nil
        end
    end)

    getgenv().ZkxESP = {
        State   = ESP,
        Cleanup = function()
            if conn then conn:Disconnect() end
            if removing then removing:Disconnect() end
            if gui then gui:Destroy() end
        end,
    }
end

