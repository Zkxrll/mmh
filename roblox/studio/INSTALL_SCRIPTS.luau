		stars = 5000,
		snow = 0.8,
	} :: Preset,
}

local function ensure(className: string, name: string): Instance
	local found = Lighting:FindFirstChild(name)
	if found and found.ClassName == className then
		return found
	end
	local inst = Instance.new(className :: any)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

function LightingPresets.apply(name: string)
	local p = LightingPresets.presets[name]
	if not p then
		error("Unknown lighting preset '" .. name .. "'")
	end
	pcall(function()
		(Lighting :: any).Technology = Enum.Technology.Future -- only allowed from Studio
	end)
	Lighting.ClockTime = p.clock
	Lighting.Brightness = p.brightness
	Lighting.Ambient = p.ambient
	Lighting.OutdoorAmbient = p.outdoor
	Lighting.ExposureCompensation = p.exposure
	Lighting.ShadowSoftness = p.shadowSoftness
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GeographicLatitude = 42

	local atm = ensure("Atmosphere", "SnowAtmosphere") :: Atmosphere
	atm.Density = p.atmosphere.density
	atm.Offset = p.atmosphere.offset
	atm.Color = p.atmosphere.color
	atm.Decay = p.atmosphere.decay
	atm.Glare = p.atmosphere.glare
	atm.Haze = p.atmosphere.haze

	local sky = Lighting:FindFirstChildOfClass("Sky")
	if not sky then
		local s = Instance.new("Sky")
		s.Parent = Lighting
		sky = s
	end
	if sky then
		sky.StarCount = p.stars
		sky.SunAngularSize = 14
		sky.MoonAngularSize = 9
		sky.CelestialBodiesShown = true
	end

	local bloom = ensure("BloomEffect", "SnowBloom") :: BloomEffect
	bloom.Intensity = p.bloom.intensity
	bloom.Size = p.bloom.size
	bloom.Threshold = p.bloom.threshold

	local cc = ensure("ColorCorrectionEffect", "SnowColor") :: ColorCorrectionEffect
	cc.Brightness = p.cc.brightness
	cc.Contrast = p.cc.contrast
	cc.Saturation = p.cc.saturation
	cc.TintColor = p.cc.tint

	local rays = ensure("SunRaysEffect", "SnowSunRays") :: SunRaysEffect
	rays.Intensity = p.sunRays.intensity
	rays.Spread = p.sunRays.spread

	local dof = ensure("DepthOfFieldEffect", "SnowDepth") :: DepthOfFieldEffect
	dof.FarIntensity = p.dof.far
	dof.NearIntensity = 0
	dof.FocusDistance = p.dof.focus
	dof.InFocusRadius = p.dof.radius

	Lighting:SetAttribute("SnowIntensity", p.snow)
	Lighting:SetAttribute("LightingPreset", name)

	-- snowy terrain palette
	local terrain = workspace.Terrain
	terrain:SetMaterialColor(Enum.Material.Snow, rgb(236, 243, 252))
	terrain:SetMaterialColor(Enum.Material.Glacier, rgb(168, 212, 240))
	terrain:SetMaterialColor(Enum.Material.Ice, rgb(150, 200, 236))
	terrain:SetMaterialColor(Enum.Material.Rock, rgb(108, 110, 120))
	terrain:SetMaterialColor(Enum.Material.Slate, rgb(92, 96, 108))
	terrain:SetMaterialColor(Enum.Material.Basalt, rgb(70, 72, 82))
	terrain:SetMaterialColor(Enum.Material.Grass, rgb(96, 128, 96))
	terrain:SetMaterialColor(Enum.Material.LeafyGrass, rgb(86, 120, 92))
end

return LightingPresets
]=])

write(kit, "ModuleScript", "SnowboardFX", [=[
--!strict
--[[
	SnowboardFX - visual + sound effects for every board model tagged "Snowboard".
	Runs on each client, so everyone sees everyone's spray, trails and sparks.

	Per board:
	  * snow spray from the trailing end (more when carving hard)
	  * carve spray thrown off the edge in turns
	  * track ribbon on the snow + neon glow trail at speed (board's glow color)
	  * jump pop, landing burst (bigger after longer air), powder puff
	  * grind sparks + grind sound on parts tagged "Grindable"
	  * carve / wind / grind sound loops driven by speed
	  * spin detection in the air -> 180 / 360 / 540 ... + Big Air, Rail Grind

	Integrate with your own game:
	  SnowboardFX.TrickLanded:Connect(function(board: Model, trick: string, info) ... end)
	  SnowboardFX.trick(board, "Backflip")   -- trigger the trick burst + sound yourself
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)
local Effects = require(script.Parent.Effects)

local TAG = "Snowboard"
local GRIND_TAG = "Grindable"
local cfg = Config.Board

type Board = {
	model: Model,
	deck: BasePart,
	owner: Player?,
	isLocal: boolean,
	longIsX: boolean,
	halfLen: number,
	halfWidth: number,
	glowColor: Color3,
	rayParams: RaycastParams,
	-- effects
	sprayAtt: Attachment,
	spray: ParticleEmitter,
	carveAtt: Attachment,
	carveSpray: ParticleEmitter,
	burst: ParticleEmitter,
	sparkle: ParticleEmitter,
	sparks: ParticleEmitter,
	track: Trail,
	glowTrail: Trail,
	carve: Sound?,
	wind: Sound?,
	grind: Sound?,
	sLand: Sound?,
	sJump: Sound?,
	sWhoosh: Sound?,
	sSuccess: Sound?,
	sPowder: Sound?,
	-- state
	grounded: boolean,
	airTime: number,
	spin: number,
	lastHeading: number,
	grinding: boolean,
	grindTime: number,
	whooshed: boolean,
	folder: Folder,
}

local SnowboardFX = {}

local trickEvent = Instance.new("BindableEvent")
SnowboardFX.TrickLanded = trickEvent.Event -- (board: Model, trick: string, info: {airTime: number, spin: number, isLocal: boolean})

local localHooks: { (board: Model, kind: string, value: number) -> () } = {}
-- Local-player hooks (camera shake, speed FOV, popups):
-- kind = "land" (value = power 0..1) | "speed" (studs/s) | "air" (seconds) | "trick:<name>" (air time)
function SnowboardFX.onLocal(fn: (board: Model, kind: string, value: number) -> ())
	table.insert(localHooks, fn)
end

local function fireLocal(b: Board, kind: string, value: number)
	if not b.isLocal then
		return
	end
	for _, fn in localHooks do
		task.spawn(fn, b.model, kind, value)
	end
end

local boards: { [Model]: Board } = {}

local SNOW = Color3.fromRGB(240, 246, 255)
local SNOW_SHADE = Color3.fromRGB(200, 218, 240)

local function findDeck(model: Model): BasePart?
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local best: BasePart? = nil
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name:match("Deck$") then
				return d
			end
			if not best or d.Size.Magnitude > best.Size.Magnitude then
				best = d
			end
		end
	end
	return best
end

local function findGlowColor(model: Model): Color3
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Material == Enum.Material.Neon then
			return d.Color
		end
	end
	return Color3.fromRGB(150, 220, 255)
end

local function longAxis(b: Board): Vector3
	local cf = b.deck.CFrame
	return if b.longIsX then cf.RightVector else cf.LookVector
end

local function heading(v: Vector3): number
	return math.atan2(v.X, v.Z)
end

local function wrapAngle(a: number): number
	return (a + math.pi) % (2 * math.pi) - math.pi
end

local function isGrindable(inst: Instance): boolean
	local cur: Instance? = inst
	for _ = 1, 4 do
		if not cur then
			break
		end
		if CollectionService:HasTag(cur, GRIND_TAG) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function trickName(spinDeg: number): string?
	local n = math.floor((spinDeg + cfg.SpinTolerance) / 180)
	if n >= 1 then
		return tostring(n * 180)
	end
	return nil
end

local function emitTrick(b: Board, name: string, airTime: number, spinDeg: number)
	b.sparkle:Emit(40)
	b.burst:Emit(25)
	Effects.play(b.sSuccess, 0.6)
	trickEvent:Fire(b.model, name, { airTime = airTime, spin = spinDeg, isLocal = b.isLocal })
	fireLocal(b, "trick:" .. name, airTime)
end

local function setup(model: Model)
	if boards[model] then
		return
	end
	local deck = findDeck(model)
	local t0 = os.clock()
	while not deck and os.clock() - t0 < 5 do
		task.wait(0.1)
		deck = findDeck(model)
	end
	if not deck or not model.Parent then
		return
	end

	local ownerId = model:GetAttribute("OwnerUserId")
	local owner = if typeof(ownerId) == "number" then Players:GetPlayerByUserId(ownerId) else nil
	local longIsX = deck.Size.X > deck.Size.Z
	local halfLen = (if longIsX then deck.Size.X else deck.Size.Z) / 2
	local halfWidth = (if longIsX then deck.Size.Z else deck.Size.X) / 2
	local bottom = -deck.Size.Y / 2
	local glowColor = findGlowColor(model)

	local folder = Instance.new("Folder")
	folder.Name = "SnowboardFX"
	folder.Parent = deck

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	-- ignore the rider (the board is parented to the character) and the board itself
	local rider = model.Parent
	params.FilterDescendantsInstances = if rider and rider:FindFirstChildOfClass("Humanoid")
		then { rider }
		else { model }

	local centre = Effects.attachment(deck, "FX_Centre", Vector3.new(0, bottom, 0))
	local sprayAtt = Effects.attachment(deck, "FX_Spray", Vector3.new(0, bottom, 0))
	local carveAtt = Effects.attachment(deck, "FX_Carve", Vector3.new(0, bottom, 0))
	local side = if longIsX then Vector3.new(0, 0, halfWidth) else Vector3.new(halfWidth, 0, 0)
	local trackL = Effects.attachment(deck, "FX_TrackL", Vector3.new(0, bottom + 0.02, 0) + side * 0.9)
	local trackR = Effects.attachment(deck, "FX_TrackR", Vector3.new(0, bottom + 0.02, 0) - side * 0.9)
	local glowL = Effects.attachment(deck, "FX_GlowL", Vector3.new(0, bottom + 0.06, 0) + side)
	local glowR = Effects.attachment(deck, "FX_GlowR", Vector3.new(0, bottom + 0.06, 0) - side)

	local spray = Effects.emitter(sprayAtt, "Spray", {
		texture = Config.Textures.SnowPuff,
		lifetime = NumberRange.new(0.35, 0.8),
		speed = NumberRange.new(4, 10),
		spread = Vector2.new(35, 55),
		size = Effects.seq({ { 0, 0.5 }, { 0.4, 1.4 }, { 1, 2.2 } }),
		transparency = Effects.seq({ { 0, 0.25 }, { 0.6, 0.55 }, { 1, 1 } }),
		color = Effects.colors(SNOW, SNOW_SHADE),
		acceleration = Vector3.new(0, -26, 0),
		drag = 2.5,
	})
	local carveSpray = Effects.emitter(carveAtt, "CarveSpray", {
		texture = Config.Textures.SnowPuff,
		lifetime = NumberRange.new(0.4, 0.9),
		speed = NumberRange.new(10, 22),
		spread = Vector2.new(18, 35),
		size = Effects.seq({ { 0, 0.4 }, { 0.5, 1.2 }, { 1, 1.8 } }),
		transparency = Effects.seq({ { 0, 0.15 }, { 0.7, 0.6 }, { 1, 1 } }),
		color = Effects.colors(SNOW, SNOW_SHADE),
		acceleration = Vector3.new(0, -34, 0),
		drag = 2,
	})
	local burst = Effects.emitter(centre, "LandBurst", {
		texture = Config.Textures.SnowPuff,
		lifetime = NumberRange.new(0.5, 1.1),
		speed = NumberRange.new(8, 18),
		spread = Vector2.new(85, 85),
		size = Effects.seq({ { 0, 0.8 }, { 0.5, 2.2 }, { 1, 3.2 } }),
		transparency = Effects.seq({ { 0, 0.2 }, { 0.6, 0.6 }, { 1, 1 } }),
		color = Effects.colors(SNOW, SNOW_SHADE),
		acceleration = Vector3.new(0, -20, 0),
		drag = 3,
		enabled = false,
	})
	local sparkle = Effects.emitter(centre, "TrickSparkle", {
		texture = Config.Textures.Sparkle,
		lifetime = NumberRange.new(0.5, 1.2),
		speed = NumberRange.new(6, 16),
		spread = Vector2.new(180, 180),
		size = Effects.seq({ { 0, 0.6 }, { 0.3, 0.9 }, { 1, 0 } }),
		transparency = Effects.seq({ { 0, 0 }, { 0.8, 0.3 }, { 1, 1 } }),
		color = Effects.colors(glowColor, Color3.new(1, 1, 1)),
		lightEmission = 1,
		lightInfluence = 0,
		drag = 4,
		enabled = false,
	})
	local sparks = Effects.emitter(centre, "GrindSparks", {
		texture = Config.Textures.Spark,
		lifetime = NumberRange.new(0.15, 0.45),
		speed = NumberRange.new(10, 20),
		spread = Vector2.new(60, 25),
		size = Effects.seq({ { 0, 0.25 }, { 1, 0 } }),
		transparency = Effects.seq({ { 0, 0 }, { 1, 0.6 } }),
		color = Effects.colors(Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 110, 30)),
		lightEmission = 1,
		lightInfluence = 0,
		acceleration = Vector3.new(0, -50, 0),
		squash = Effects.seq({ { 0, 2 }, { 1, 2 } }),
		enabled = false,
	})
	local track = Effects.trail(
		folder,
		"Track",
		trackL,
		trackR,
		Effects.colors(Color3.fromRGB(215, 230, 250)),
		Effects.seq({ { 0, 0.55 }, { 1, 1 } }),
		1.6
	)
	local glowTrail = Effects.trail(
		folder,
		"GlowTrail",
		glowL,
		glowR,
		Effects.colors(glowColor, Color3.new(1, 1, 1)),
		Effects.seq({ { 0, 0.35 }, { 1, 1 } }),
		0.35,
		1
	)

	local s = Config.Sounds
	local b: Board = {
		model = model,
		deck = deck,
		owner = owner,
		isLocal = owner == Players.LocalPlayer,
		longIsX = longIsX,
		halfLen = halfLen,
		halfWidth = halfWidth,
		glowColor = glowColor,
		rayParams = params,
		sprayAtt = sprayAtt,
		spray = spray,
		carveAtt = carveAtt,
		carveSpray = carveSpray,
		burst = burst,
		sparkle = sparkle,
		sparks = sparks,
		track = track,
		glowTrail = glowTrail,
		carve = Effects.sound(folder, "Carve", s.Carve, true, 0),
		wind = nil,
		grind = Effects.sound(folder, "Grind", s.Grind, true, 0),
		sLand = Effects.sound(folder, "Land", s.Land, false, 0.8),
		sJump = Effects.sound(folder, "Jump", s.Jump, false, 0.6),
		sWhoosh = Effects.sound(folder, "Whoosh", s.Whoosh, false, 0.5),
		sSuccess = Effects.sound(folder, "Success", s.TrickSuccess, false, 0.6),
		sPowder = Effects.sound(folder, "Powder", s.Powder, false, 0.6),
		grounded = true,
		airTime = 0,
		spin = 0,
		lastHeading = 0,
		grinding = false,
		grindTime = 0,
		whooshed = false,
		folder = folder,
	}
	b.lastHeading = heading(longAxis(b))
	if b.isLocal then
		b.wind = Effects.sound(folder, "Wind", s.Wind, true, 0)
	end
	for _, snd in { b.carve, b.wind, b.grind } do
		if snd then
			snd:Play()
		end
	end
	boards[model] = b
end

local function teardown(model: Model)
	local b = boards[model]
	if not b then
		return
	end
	boards[model] = nil
	if b.folder.Parent then
		b.folder:Destroy()
	end
	for _, name in { "FX_Centre", "FX_Spray", "FX_Carve", "FX_TrackL", "FX_TrackR", "FX_GlowL", "FX_GlowR" } do
		local a = b.deck:FindFirstChild(name)
		if a then
			a:Destroy()
		end
	end
end

local function step(b: Board, dt: number)
	local deck = b.deck
	if not deck.Parent then
		teardown(b.model)
		return
	end
	local vel = deck.AssemblyLinearVelocity
	local flat = Vector3.new(vel.X, 0, vel.Z)
	local speed = flat.Magnitude
	local up = deck.CFrame.UpVector
	local long = longAxis(b)

	local hit = workspace:Raycast(deck.Position + up * 0.5, -up * (cfg.GroundRay + 0.5), b.rayParams)
	local grounded = hit ~= nil
	local onRail = hit ~= nil and isGrindable(hit.Instance)

	-- trailing end follows the direction of travel
	local sign = if flat:Dot(long) >= 0 then -1 else 1
	local localLong = if b.longIsX then Vector3.xAxis else Vector3.zAxis
	b.sprayAtt.Position = Vector3.new(0, -deck.Size.Y / 2, 0) + localLong * (b.halfLen * 0.85 * sign)

	-- carving = sideways slide relative to the board
	local sideDir = up:Cross(long)
	local lateral = if speed > 0.1 then flat:Dot(sideDir) else 0
	local carveAmt = math.clamp(math.abs(lateral) / 18, 0, 1)
	local speedAmt = math.clamp((speed - cfg.SprayMinSpeed) / 60, 0, 1)

	if grounded and not onRail then
		b.spray.Rate = cfg.SprayMaxRate * speedAmt * (0.35 + 0.65 * carveAmt)
		b.spray.Speed = NumberRange.new(3 + 6 * speedAmt, 8 + 14 * speedAmt)
		if carveAmt > 0.15 and speed > 10 then
			local outDir = (sideDir * math.sign(lateral) * 0.8 + up * 0.75 - flat.Unit * 0.25).Unit
			local pos = deck.Position - up * (deck.Size.Y / 2) + sideDir * math.sign(lateral) * b.halfWidth
			local right = outDir:Cross(Vector3.yAxis)
			if right.Magnitude < 0.01 then
				right = Vector3.xAxis
			end
			b.carveAtt.WorldCFrame = CFrame.fromMatrix(pos, right.Unit, outDir)
			b.carveSpray.Rate = 140 * carveAmt * speedAmt
		else
			b.carveSpray.Rate = 0
		end
		b.track.Enabled = speed > 2
	else
		b.spray.Rate = 0
		b.carveSpray.Rate = 0
		b.track.Enabled = false
	end
	b.glowTrail.Enabled = speed > cfg.GlowTrailSpeed or (not grounded and b.airTime > 0.2)

	-- grinding
	if onRail and speed > 3 then
		if not b.grinding then
			b.grinding = true
			b.grindTime = 0
		end
		b.grindTime += dt
		b.sparks.Enabled = true
		b.sparks.Rate = 60 + speed * 2
	elseif b.grinding then
		b.grinding = false
		b.sparks.Enabled = false
		if b.grindTime >= cfg.GrindMinTime then
			emitTrick(b, "Rail Grind", b.airTime, 0)
		end
	end

	-- air time, spins, jumps and landings
	local h = heading(long)
	if not grounded then
		if b.grounded then
			-- just left the ground
			b.airTime = 0
			b.spin = 0
			b.whooshed = false
			if vel.Y > 4 then
				Effects.play(b.sJump, 0.6, 0.95 + math.random() * 0.1)
				b.burst:Emit(8)
			end
		end
		b.airTime += dt
		b.spin += wrapAngle(h - b.lastHeading)
		if not b.whooshed and math.abs(b.spin) > math.rad(120) then
			b.whooshed = true
			Effects.play(b.sWhoosh, 0.5, 0.9 + math.random() * 0.2)
		end
		if b.airTime > 0.3 then
			fireLocal(b, "air", b.airTime)
		end
	elseif not b.grounded then
		-- just landed
		local air = b.airTime
		if air >= cfg.LandMinAirTime then
			local power = math.clamp(air / 1.5, 0.3, 1)
			b.burst:Emit(math.floor(20 + 50 * power))
			Effects.play(b.sLand, 0.5 + 0.5 * power, 1.05 - 0.15 * power)
			if air > 0.8 then
				Effects.play(b.sPowder, 0.6)
			end
			fireLocal(b, "land", power)
			local spinDeg = math.abs(math.deg(b.spin))
			local name = trickName(spinDeg)
			if name then
				emitTrick(b, name, air, spinDeg)
			elseif air >= cfg.HugeAirTime then
				emitTrick(b, "Huge Air", air, spinDeg)
			elseif air >= cfg.BigAirTime then
				emitTrick(b, "Big Air", air, spinDeg)
			end
		end
		b.airTime = 0
		b.spin = 0
	end
	b.lastHeading = h
	b.grounded = grounded

	-- sound loops
	if b.carve then
		local target = if grounded and not onRail then 0.15 + 0.85 * speedAmt * (0.5 + 0.5 * carveAmt) else 0
		if speed < 1 then
			target = 0
		end
		b.carve.Volume += (target - b.carve.Volume) * math.min(1, dt * 8)
		b.carve.PlaybackSpeed = 0.8 + 0.5 * speedAmt
	end
	if b.grind then
		local target = if b.grinding then 0.8 else 0
		b.grind.Volume += (target - b.grind.Volume) * math.min(1, dt * 12)
		b.grind.PlaybackSpeed = 0.9 + 0.3 * speedAmt
	end
	if b.wind then
		local target = Config.Ambience.WindVolume + 0.9 * math.clamp((speed - 15) / 70, 0, 1)
		b.wind.Volume += (target - b.wind.Volume) * math.min(1, dt * 3)
		b.wind.PlaybackSpeed = 0.85 + 0.35 * speedAmt
	end

	fireLocal(b, "speed", speed)
end

-- Play the trick burst + chime yourself (e.g. from your own trick system).
function SnowboardFX.trick(model: Model, name: string)
	local b = boards[model]
	if b then
		emitTrick(b, name, b.airTime, 0)
	end
end

local started = false
function SnowboardFX.start()
	if started then
		return
	end
	started = true
	for _, inst in CollectionService:GetTagged(TAG) do
		if inst:IsA("Model") then
			task.spawn(setup, inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(function(inst)
		if inst:IsA("Model") then
			task.spawn(setup, inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(inst)
		if inst:IsA("Model") then
			teardown(inst)
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		for _, b in boards do
			step(b, dt)
		end
	end)
end

return SnowboardFX
]=])

client = write(starterScripts, "LocalScript", "SnowboardClient", [=[
--!strict
-- SnowboardClient: starts every client-side effect. Lives in StarterPlayerScripts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = ReplicatedStorage:WaitForChild("SnowboardKit")
local SnowboardFX = require(Kit:WaitForChild("SnowboardFX"))
local EnvironmentFX = require(Kit:WaitForChild("EnvironmentFX"))

local Ambience = require(script:WaitForChild("Ambience"))
local CameraFX = require(script:WaitForChild("CameraFX"))
local Popup = require(script:WaitForChild("Popup"))
local BoardPicker = require(script:WaitForChild("BoardPicker"))

SnowboardFX.start()
EnvironmentFX.start()
Ambience.start()
CameraFX.start()

SnowboardFX.onLocal(function(_board, kind, airTime)
	local name = kind:match("^trick:(.+)$")
	if not name then
		return
	end
	if name:match("^%d+$") then
		Popup.show(name .. "!", "spin", string.format("%.1fs air", airTime))
	elseif name == "Rail Grind" then
		Popup.show("RAIL GRIND!", "grind")
	else
		Popup.show(name:upper() .. "!", "air", string.format("%.1fs", airTime))
	end
end)

EnvironmentFX.FinishCrossed:Connect(function()
	Popup.show("FINISH!", "finish")
end)

task.spawn(BoardPicker.start)
]=])

write(client, "ModuleScript", "Ambience", [=[
--!strict
-- Falling snow that follows the camera + a soft ambient wind bed.
-- Snow amount follows the Lighting attribute "SnowIntensity" (set by the lighting presets).

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Kit = game:GetService("ReplicatedStorage"):WaitForChild("SnowboardKit")
local Config = require(Kit:WaitForChild("Config"))
local Effects = require(Kit:WaitForChild("Effects"))

local Ambience = {}

function Ambience.start()
	local camera = workspace.CurrentCamera
	if Config.Ambience.Snowfall then
		local emitterPart = Instance.new("Part")
		emitterPart.Name = "SnowfallEmitter"
		emitterPart.Anchored = true
		emitterPart.CanCollide = false
		emitterPart.CanQuery = false
		emitterPart.CanTouch = false
		emitterPart.CastShadow = false
		emitterPart.Transparency = 1
		emitterPart.Size = Vector3.new(140, 1, 140)
		emitterPart.Parent = camera

		local flakes = Effects.emitter(emitterPart, "Snow", {
			texture = Config.Textures.Snowflake,
			lifetime = NumberRange.new(7, 11),
			speed = NumberRange.new(3, 6),
			spread = Vector2.new(15, 15),
			size = Effects.seq({ { 0, 0.18 }, { 0.5, 0.3 }, { 1, 0.2 } }),
			transparency = Effects.seq({ { 0, 1 }, { 0.08, 0.15 }, { 0.85, 0.2 }, { 1, 1 } }),
			color = Effects.colors(Color3.fromRGB(255, 255, 255)),
			acceleration = Vector3.new(2.5, -0.5, 1),
			rotSpeed = NumberRange.new(-120, 120),
			lightEmission = 0.25,
			direction = Enum.NormalId.Bottom,
		})

		local t = 0
		RunService.RenderStepped:Connect(function(dt: number)
			t += dt
			local pos = camera.CFrame.Position
			emitterPart.CFrame = CFrame.new(pos + Vector3.new(0, 35, 0))
			local intensity = Lighting:GetAttribute("SnowIntensity")
			local k = if typeof(intensity) == "number" then intensity else 1
			-- gentle gusts
			local gust = 0.75 + 0.25 * math.noise(t * 0.15, 3.3)
			flakes.Rate = Config.Ambience.SnowRate * k * gust
			flakes.Acceleration = Vector3.new(2.5 + 4 * k * gust, -0.5, 1 + 2 * math.noise(t * 0.1, 7))
		end)
	end

	local wind = Effects.sound(SoundService, "AmbientWind", Config.Sounds.Wind, true, Config.Ambience.WindVolume * 0.6)
	if wind then
		wind:Play()
	end
end

return Ambience
]=])

write(client, "ModuleScript", "BoardPicker", [=[
--!strict
-- Board picker: a "BOARDS" button opens a panel of cards, each with a slowly
-- spinning 3D preview of the board (ViewportFrame) and an EQUIP button.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Kit = ReplicatedStorage:WaitForChild("SnowboardKit")
local Config = require(Kit:WaitForChild("Config"))
local Effects = require(Kit:WaitForChild("Effects"))

local BoardPicker = {}

local PANEL_BG = Color3.fromRGB(18, 24, 42)
local CARD_BG = Color3.fromRGB(32, 42, 70)
local ACCENT = Color3.fromRGB(90, 200, 255)

local function corner(parent: Instance, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3, t: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = t
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function prettyName(name: string): string
	local n = name:gsub("^board_", ""):gsub("_", " ")
	return n:upper()
end

local function button(parent: Instance, text: string, color: Color3): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundColor3 = color
	b.Font = Enum.Font.GothamBlack
	b.Text = text
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = parent
	corner(b, 10)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.18, 0)
	pad.PaddingBottom = UDim.new(0.18, 0)
	pad.Parent = b
	local base = color
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.2) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = base }):Play()
	end)
	return b
end

local function viewport(parent: Instance, model: Model): (ViewportFrame, Model)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundColor3 = Color3.fromRGB(45, 60, 100)
	vp.Size = UDim2.new(1, -16, 0.62, 0)
	vp.Position = UDim2.fromOffset(8, 8)
	vp.Ambient = Color3.fromRGB(170, 180, 200)
	vp.LightColor = Color3.fromRGB(255, 250, 240)
	vp.LightDirection = Vector3.new(-1, -2, -1)
	vp.Parent = parent
	corner(vp, 10)
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(120, 170, 255), Color3.fromRGB(40, 50, 90))
	grad.Rotation = 90
	grad.Parent = vp

	local clone = model:Clone()
	for _, d in clone:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	clone:PivotTo(CFrame.identity)
	clone.Parent = vp
	local cf, size = clone:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local dist = size.Magnitude * 1.7
	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(dist * 0.55, dist * 0.55, dist * 0.6), cf.Position)
	cam.Parent = vp
	vp.CurrentCamera = cam
	return vp, clone
end

function BoardPicker.start()
	local player = Players.LocalPlayer
	local folder = ReplicatedStorage:WaitForChild(Config.BoardsFolder, 30)
	local remote = Kit:WaitForChild("BoardRemote", 30)
	if not folder or not remote or not remote:IsA("RemoteEvent") then
		warn("[SnowboardKit] BoardPicker: no ReplicatedStorage." .. Config.BoardsFolder .. " or BoardRemote found")
		return
	end
	local click = Effects.sound(SoundService, "UISelect", Config.Sounds.UISelect, false, 0.5)
	local equipSound = Effects.sound(SoundService, "EquipClick", Config.Sounds.Equip, false, 0.7)

	local gui = Instance.new("ScreenGui")
	gui.Name = "BoardPicker"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local open = button(gui, "BOARDS", ACCENT)
	open.AnchorPoint = Vector2.new(0, 1)
	open.Position = UDim2.new(0, 16, 1, -16)
	open.Size = UDim2.fromOffset(150, 48)
	stroke(open, Color3.fromRGB(20, 30, 60), 3)

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromScale(0.7, 0.72)
	panel.BackgroundColor3 = PANEL_BG
	panel.BackgroundTransparency = 0.05
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 18)
	stroke(panel, ACCENT, 2)
	local sizeLimit = Instance.new("UISizeConstraint")
	sizeLimit.MaxSize = Vector2.new(980, 640)
	sizeLimit.Parent = panel
	local panelScale = Instance.new("UIScale")
	panelScale.Parent = panel

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(24, 12)
	title.Size = UDim2.new(1, -120, 0, 44)
	title.Font = Enum.Font.GothamBlack
	title.Text = "CHOOSE YOUR BOARD"
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = panel

	local close = button(panel, "X", Color3.fromRGB(220, 60, 80))
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -14, 0, 14)
	close.Size = UDim2.fromOffset(40, 40)

	local list = Instance.new("ScrollingFrame")
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(16, 68)
	list.Size = UDim2.new(1, -32, 1, -84)
	list.ScrollBarThickness = 6
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = panel
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(210, 250)
	grid.CellPadding = UDim2.fromOffset(14, 14)
	grid.SortOrder = Enum.SortOrder.Name
	grid.Parent = list

	local spinning: { Model } = {}
	local equipButtons: { [string]: TextButton } = {}

	local function refresh()
		local current = player:GetAttribute("EquippedBoard")
		for name, b in equipButtons do
			local on = current == name
			b.Text = if on then "UNEQUIP" else "EQUIP"
			b.BackgroundColor3 = if on then Color3.fromRGB(230, 90, 70) else Color3.fromRGB(60, 190, 120)
		end
	end

	local function addCard(model: Model)
		local card = Instance.new("Frame")
		card.Name = model.Name
		card.BackgroundColor3 = CARD_BG
		card.Parent = list
		corner(card, 14)
		local _, clone = viewport(card, model)
		table.insert(spinning, clone)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Position = UDim2.new(0, 10, 0.64, 0)
		label.Size = UDim2.new(1, -20, 0.13, 0)
		label.Font = Enum.Font.GothamBold
		label.Text = prettyName(model.Name)
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextScaled = true
		label.Parent = card
		local equip = button(card, "EQUIP", Color3.fromRGB(60, 190, 120))
		equip.Position = UDim2.new(0, 12, 0.8, 0)
		equip.Size = UDim2.new(1, -24, 0.15, 0)
		equipButtons[model.Name] = equip
		equip.Activated:Connect(function()
			Effects.play(click)
			local on = player:GetAttribute("EquippedBoard") == model.Name
			remote:FireServer(if on then "Unequip" else "Equip", model.Name)
			if not on then
				Effects.play(equipSound)
			end
		end)
	end

	for _, m in folder:GetChildren() do
		if m:IsA("Model") then
			addCard(m)
		end
	end
	folder.ChildAdded:Connect(function(m)
		if m:IsA("Model") then
			addCard(m)
			refresh()
		end
	end)
	player:GetAttributeChangedSignal("EquippedBoard"):Connect(refresh)
	refresh()

	local function setOpen(v: boolean)
		Effects.play(click)
		if v then
			panel.Visible = true
			panelScale.Scale = 0.85
			TweenService:Create(panelScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		else
			panel.Visible = false
		end
	end
	open.Activated:Connect(function()
		setOpen(not panel.Visible)
	end)
	close.Activated:Connect(function()
		setOpen(false)
	end)

	local angle = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if not panel.Visible then
			return
		end
		angle += dt * 0.8
		for _, m in spinning do
			m:PivotTo(CFrame.Angles(0, angle, 0))
		end
	end)
end

return BoardPicker
]=])

write(client, "ModuleScript", "CameraFX", [=[
--!strict
-- Local rider feel: FOV opens up with speed, speed lines at high speed, a punchy shake on landing.

local RunService = game:GetService("RunService")

local Kit = game:GetService("ReplicatedStorage"):WaitForChild("SnowboardKit")
local Config = require(Kit:WaitForChild("Config"))
local Effects = require(Kit:WaitForChild("Effects"))
local SnowboardFX = require(Kit:WaitForChild("SnowboardFX"))

local CameraFX = {}

local c = Config.Camera
local speed = 0
local lastSpeedTime = 0
local shake = 0

function CameraFX.start()
	local camera = workspace.CurrentCamera

	local linesPart = Instance.new("Part")
	linesPart.Name = "SpeedLines"
	linesPart.Anchored = true
	linesPart.CanCollide = false
	linesPart.CanQuery = false
	linesPart.CanTouch = false
	linesPart.CastShadow = false
	linesPart.Transparency = 1
	linesPart.Size = Vector3.new(34, 20, 1)
	linesPart.Parent = camera
	local lines = Effects.emitter(linesPart, "Lines", {
		texture = Config.Textures.Streak,
		lifetime = NumberRange.new(0.18, 0.3),
		speed = NumberRange.new(60, 90),
		spread = Vector2.new(0, 0),
		size = Effects.seq({ { 0, 0.08 }, { 1, 0.04 } }),
		transparency = Effects.seq({ { 0, 1 }, { 0.3, 0.55 }, { 1, 1 } }),
		squash = Effects.seq({ { 0, 8 }, { 1, 8 } }),
		orientation = Enum.ParticleOrientation.VelocityParallel,
		lightEmission = 1,
		lightInfluence = 0,
		direction = Enum.NormalId.Back,
		rotSpeed = NumberRange.new(0, 0),
		rotation = NumberRange.new(0, 0),
	})

	SnowboardFX.onLocal(function(_board, kind, value)
		if kind == "speed" then
			speed = value
			lastSpeedTime = os.clock()
		elseif kind == "land" and c.LandShake then
			shake = math.max(shake, 0.35 * value)
		end
	end)

	RunService:BindToRenderStep("SnowboardCameraFX", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		-- speed is only reported while riding; ease back when off the board
		local s = if os.clock() - lastSpeedTime < 0.3 then speed else 0
		local k = math.clamp((s - c.FovSpeedLow) / (c.FovSpeedHigh - c.FovSpeedLow), 0, 1)
		local fov = c.BaseFov + c.MaxFovBoost * k * k
		camera.FieldOfView += (fov - camera.FieldOfView) * math.min(1, dt * 4)

		if c.SpeedLines then
			linesPart.CFrame = camera.CFrame * CFrame.new(0, 0, -14)
			lines.Rate = if s > c.SpeedLinesFrom then 60 + 4 * (s - c.SpeedLinesFrom) else 0
		end

		if shake > 0.001 then
			local r = shake
			camera.CFrame *= CFrame.new((math.random() - 0.5) * r * 0.6, (math.random() - 0.5) * r * 0.6, 0) * CFrame.Angles(
				(math.random() - 0.5) * r * 0.05,
				0,
				(math.random() - 0.5) * r * 0.05
			)
			shake *= math.exp(-dt * 9)
		end
	end)
end

return CameraFX
]=])

