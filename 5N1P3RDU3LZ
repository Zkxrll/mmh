-- ══════════════ keybind picker ══════════════

local function rebindablePicker(gb, labelText, currentKey, onPick)
    if not gb then return nil end
    local state = { listening = false }
    local btn
    local ok, b = pcall(function()
        return gb:AddButton({
            Text = labelText .. ': ' .. (currentKey and describeInput(currentKey) or 'none'),
            Func = function()
                state.listening = true
                pickerCount = pickerCount + 1
                pcall(function() btn:SetText(labelText .. ': ...press a key') end)
            end,
        })
    end)
    if not ok or type(b) ~= 'table' then return nil end
    btn = b

    local conn = UserInputService.InputBegan:Connect(function(input)
        if not state.listening then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then return end
        state.listening = false
        pickerCount = math.max(0, pickerCount - 1)
        if input.KeyCode == Enum.KeyCode.Escape then
            pcall(function() btn:SetText(labelText .. ': ' .. describeInput(currentKey or 'none')) end)
            return
        end
        local picked
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            picked = input.UserInputType
        else
            picked = input.KeyCode
        end
        onPick(picked)
        currentKey = picked
        pcall(function() btn:SetText(labelText .. ': ' .. describeInput(picked)) end)
    end)
    table.insert(connections, conn)
    return btn
end

-- ══════════════ obsidian ui ══════════════
-- this build ignores options tables on AddToggle/AddSlider/AddDropdown
-- (key-read-probed), so components are created bare and configured via
-- their own setters: SetText / SetValue / SetMin / SetMax / SetValues.

local okLib, libResult = pcall(function()
    return loadstring(game:HttpGet('https://raw.githubusercontent.com/deividcomsono/Obsidian/refs/heads/main/Library.lua', true))()
end)
if okLib and type(libResult) == 'table' then
    Library = libResult
else
    warn('[ZkxHub] Obsidian failed to load — headless mode (keybinds still work)')
end

if Library then
    local okWin, win = pcall(function()
        return Library:CreateWindow({
            Title = 'ZkxHub',
            Footer = 'sniper duels',
            Size = UDim2.new(0, 560, 0, 400),
            ToggleKeybind = Settings.MenuKey,
        })
    end)

    if not okWin or type(win) ~= 'table' then
        warn('[ZkxHub] CreateWindow failed: ' .. tostring(win))
        Library = nil
    else
        Window = win
        libKey = Settings.MenuKey

        -- ── silent maintenance ──
        -- the library gui builds async (early snapshots catch nothing), so
        -- it's found BY NAME on a short schedule; it gets rescued out of
        -- RobloxGui on fake-gethui executors, and stray "Label" texts /
        -- wrapped fragments get hidden. all silent.

        local function findObsidianGuis()
            local out = {}
            local function collect(parent)
                if typeof(parent) ~= 'Instance' then return end
                for _, c in ipairs(parent:GetChildren()) do
                    if c:IsA('ScreenGui') and c.Name == 'Obsidian' then
                        out[#out + 1] = c
                    end
                end
            end
            pcall(collect, game:GetService('CoreGui'))
            if type(gethui) == 'function' then
                local ok, ui = pcall(gethui)
                if ok then pcall(collect, ui) end
            end
            pcall(collect, LocalPlayer:FindFirstChildOfClass('PlayerGui'))
            return out
        end

        local LABEL_FRAGMENTS = { a = true, b = true, e = true, l = true }

        local function silentSweep()
            local function walk(inst)
                local isLabel = inst:IsA('TextLabel')
                if isLabel or inst:IsA('TextButton') or inst:IsA('TextBox') then
                    local t = inst.Text
                    if type(t) == 'string' and #t > 0 and #t < 40 then
                        local norm = t:lower():gsub('^%s+', ''):gsub('%s+$', '')
                        if norm == 'label'
                            or (isLabel and #norm == 1 and LABEL_FRAGMENTS[norm] ~= nil) then
                            inst.Visible = false
                            return
                        end
                    end
                end
                for _, c in ipairs(inst:GetChildren()) do
                    pcall(walk, c)
                end
            end
            for _, g in ipairs(findObsidianGuis()) do
                if g.Parent then pcall(walk, g) end
            end
        end

        local function delayedRescue()
            for _, g in ipairs(findObsidianGuis()) do
                if not table.find(windowGuis, g) then
                    windowGuis[#windowGuis + 1] = g
                end
                if g:GetFullName():find('RobloxGui', 1, true) then
                    pcall(function() g.Parent = game:GetService('CoreGui') end)
                end
            end
        end

        task.delay(0.3, function() delayedRescue() silentSweep() end)
        task.delay(1, function() delayedRescue() silentSweep() end)
        task.delay(2.5, function() delayedRescue() silentSweep() end)

        -- ── tabs + groupboxes ──

        local okTabC, TabCombat  = pcall(function() return Window:AddTab({ Name = 'Combat',  Icon = 'crosshair' }) end)
        local okTabV, TabVisuals = pcall(function() return Window:AddTab({ Name = 'Visuals', Icon = 'eye' }) end)
        local okTabM, TabMisc    = pcall(function() return Window:AddTab({ Name = 'Misc',    Icon = 'settings' }) end)

        -- combat: aimbot LEFT, targeting RIGHT
        local GBCombat, GBTarget
        if okTabC and type(TabCombat) == 'table' then
            local okL, l = pcall(function() return TabCombat:AddLeftGroupbox({ Name = 'Aimbot' }) end)
            if okL and type(l) == 'table' then GBCombat = l end
            local okR, r = pcall(function() return TabCombat:AddRightGroupbox({ Name = 'Targeting' }) end)
            if okR and type(r) == 'table' then GBTarget = r end
            if not GBCombat then
                local ok, gb = pcall(function() return TabCombat:AddGroupbox({ Name = 'Aimbot' }) end)
                if ok and type(gb) == 'table' then GBCombat = gb end
            end
            if not GBTarget then GBTarget = GBCombat end
        end

        local function safeGB(tab, name)
            if not (tab and type(tab) == 'table') then return nil end
            local ok, gb = pcall(function() return tab:AddGroupbox({ Name = name }) end)
            if ok and type(gb) == 'table' then return gb end
            return nil
        end

        local GBVisuals = safeGB(okTabV and TabVisuals, 'ESP')
        local GBMove    = safeGB(okTabM and TabMisc, 'Movement')
        local GBKeys    = safeGB(okTabM and TabMisc, 'Keybinds')
        local GBUnl    = safeGB(okTabM and TabMisc, 'Unload Script')

        -- ── component builders ──

        local function wire(obj, fn)
            if type(obj) ~= 'table' then return end
            pcall(function() obj:OnChanged(fn) end)
            pcall(function() obj:Callback(fn) end)
        end

        local function addToggle(gb, text, default, fn)
            if not gb then return nil end
            local ok, obj = pcall(function() return gb:AddToggle({}) end)
            if not ok or type(obj) ~= 'table' then return nil end
            pcall(function() obj:SetText(text) end)
            pcall(function() obj:SetValue(default) end)
            wire(obj, fn)
            return obj
        end

        local function addSlider(gb, text, min, max, default, fn, suffix)
            if not gb then return nil end
            local ok, obj = pcall(function() return gb:AddSlider({}) end)
            if not ok or type(obj) ~= 'table' then return nil end
            pcall(function() obj:SetText(text) end)
            pcall(function() obj:SetMin(min) end)
            pcall(function() obj:SetMax(max) end)
            if suffix then pcall(function() obj:SetSuffix(suffix) end) end
            pcall(function() obj:SetValue(default) end)
            wire(obj, fn)
            return obj
        end

        local function addDropdown(gb, text, values, default, fn)
            if not gb then return nil end
            local ok, obj = pcall(function() return gb:AddDropdown({}) end)
            if not ok or type(obj) ~= 'table' then return nil end
            pcall(function() obj:SetText(text) end)
            pcall(function() obj:SetValues(values) end)
            pcall(function() obj:SetValue(default) end)
            wire(obj, fn)
            return obj
        end

        local function addButton(gb, text, fn)
            if not gb then return nil end
            local ok, obj = pcall(function() return gb:AddButton({ Text = text, Func = fn }) end)
            if not ok or type(obj) ~= 'table' then return nil end
            return obj
        end

        local function single(cb)
            return function(v)
                if type(v) == 'table' then v = v[1] end
                if v ~= nil then cb(v) end
            end
        end

        -- ── combat left: aimbot ──

        UIComps.aim = addToggle(GBCombat, 'Aimbot', Settings.Aimbot, function(v)
            Settings.Aimbot = v scheduleSave()
        end)

        rebindablePicker(GBCombat, 'Aim Key', Settings.AimKey, function(picked)
            Settings.AimKey = picked
            scheduleSave()
        end)

        addSlider(GBCombat, 'FOV', 20, 400, Settings.FOV, function(v)
            Settings.FOV = v scheduleSave()
        end)

        addSlider(GBCombat, 'Smoothing', 1, 12, Settings.Smoothing, function(v)
            Settings.Smoothing = v scheduleSave()
        end)

        local engines = HAS_MOUSEMOVE and { 'Camera', 'Mouse' } or { 'Camera' }
        addDropdown(GBCombat, 'Aim Engine', engines, Settings.AimEngine, single(function(v)
            Settings.AimEngine = v scheduleSave()
        end))

        addToggle(GBCombat, 'FOV Circle', Settings.ShowFOV, function(v)
            Settings.ShowFOV = v scheduleSave()
        end)

        if HAS_MOUSEMOVE then
            addSlider(GBCombat, 'Mouse Strength', 1, 100, Settings.MouseFactor, function(v)
                Settings.MouseFactor = v scheduleSave()
            end)
        end

        -- ── combat right: targeting ──

        addDropdown(GBTarget, 'Target Part', { 'Head', 'HumanoidRootPart' }, Settings.TargetPart, single(function(v)
            Settings.TargetPart = v scheduleSave()
        end))

        addToggle(GBTarget, 'Visible Check', Settings.VisibleCheck, function(v)
            Settings.VisibleCheck = v scheduleSave()
        end)

        UIComps.team = addToggle(GBTarget, 'Team Check', Settings.TeamCheck, function(v)
            Settings.TeamCheck = v scheduleSave()
        end)

        -- ── visuals ──

        UIComps.esp = addToggle(GBVisuals, 'ESP', Settings.ESP, function(v)
            Settings.ESP = v scheduleSave()
        end)
        addToggle(GBVisuals, 'Box', Settings.ESPBox, function(v)
            Settings.ESPBox = v scheduleSave()
        end)
        addToggle(GBVisuals, 'Name', Settings.ESPName, function(v)
            Settings.ESPName = v scheduleSave()
        end)
        addToggle(GBVisuals, 'Health Bar', Settings.ESPHealth, function(v)
            Settings.ESPHealth = v scheduleSave()
        end)
        addToggle(GBVisuals, 'Tracer', Settings.ESPTracer, function(v)
            Settings.ESPTracer = v scheduleSave()
        end)
        addSlider(GBVisuals, 'Max Distance', 100, 3000, Settings.ESPMaxDist, function(v)
            Settings.ESPMaxDist = v scheduleSave()
        end)

        -- ── movement ──

        UIComps.noclip = addToggle(GBMove, 'Noclip', Settings.Noclip, function(v)
            Settings.Noclip = v
            if v then enableNoclip() else disableNoclip() end
            scheduleSave()
        end)
        UIComps.speed = addToggle(GBMove, 'Speed Hold', Settings.Speed, function(v)
            Settings.Speed = v
            if not v then restoreSpeed() end
            scheduleSave()
        end)
        addSlider(GBMove, 'Boost Speed', 16, 250, Settings.SpeedValue, function(v)
            Settings.SpeedValue = v scheduleSave()
        end)

        -- ── keybinds (aim key lives in Combat) ──

        rebindablePicker(GBKeys, 'Menu Key', Settings.MenuKey, function(picked)
            Settings.MenuKey = picked
            scheduleSave()
        end)
        rebindablePicker(GBKeys, 'Noclip Key', Settings.NoclipKey, function(picked)
            Settings.NoclipKey = picked
            scheduleSave()
        end)

        -- ── session ──

        addButton(GBUnl, 'Unload', function()
            genv.__ZkxHubSD = nil
            pcall(function() RunService:UnbindFromRenderStep('ZkxHubSDAim') end)
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            disableNoclip()
            restoreSpeed()
            for plr in pairs(espObjects) do espRemove(plr) end
            for plr in pairs(highlights) do hlRemove(plr) end
            if fovCircle then pcall(function() fovCircle:Remove() end) end
            if mobileGui then pcall(function() mobileGui:Destroy() end) end
            pcall(function() Library:Unload() end)
        end)

        if Settings.Noclip then enableNoclip() end

        pcall(function()
            Library:Notify({
                Title = 'ZkxHub',
                Content = IsMobile and 'buttons on the right — drag to move'
                    or 'aim = hold your key (picker in Combat) · team check live',
                Duration = 5,
            })
        end)
    end
end

local function syncComp(comp, v)
    if type(comp) == 'table' and type(comp.SetValue) == 'function' then
        pcall(comp.SetValue, comp, v)
    end
end

-- ══════════════ mobile button rig ══════════════

if IsMobile then
    mobileGui = Instance.new('ScreenGui')
    mobileGui.Name = 'ZkxHubButtons'
    mobileGui.ResetOnSpawn = false
    mobileGui.IgnoreGuiInset = true
    mobileGui.DisplayOrder = 999
    local okP = pcall(function() mobileGui.Parent = game:GetService('CoreGui') end)
    if not mobileGui.Parent then mobileGui.Parent = LocalPlayer:WaitForChild('PlayerGui') end

    local cam0 = workspace.CurrentCamera
    local screen = cam0 and cam0.ViewportSize or Vector2.new(500, 500)

    local DEFAULT_W = math.floor(screen.X * 0.13)
    local DEFAULT_H = math.floor(screen.Y * 0.09)
    local MIN_SIZE, MAX_SIZE = 40, 300

    local defs = {
        { id = 'esp',  label = 'ESP',  color = Color3.fromRGB(50, 120, 255), yFrac = 0.30, kind = 'toggle' },
        { id = 'aim',  label = 'AIM',  color = Color3.fromRGB(255, 80, 80),  yFrac = 0.40, kind = 'hold'   },
        { id = 'spd',  label = 'SPD',  color = Color3.fromRGB(80, 200, 80),  yFrac = 0.50, kind = 'hold'   },
        { id = 'nc',   label = 'NC',   color = Color3.fromRGB(180, 80, 255), yFrac = 0.60, kind = 'toggle' },
        { id = 'menu', label = 'MENU', color = Color3.fromRGB(230, 180, 60), yFrac = 0.70, kind = 'menu'   },
    }

    local function makeButton(def)
        local state = {
            x = screen.X - DEFAULT_W - 8,
            y = math.floor(screen.Y * def.yFrac),
            w = DEFAULT_W, h = DEFAULT_H,
            on = false, dragging = false, dragId = nil,
            offX = 0, offY = 0, moved = 0,
        }

        local frame = Instance.new('Frame')
        frame.BackgroundColor3 = def.color
        frame.BackgroundTransparency = 0.4
        frame.BorderSizePixel = 0
        frame.ZIndex = 10
        frame.Position = UDim2.fromOffset(state.x, state.y)
        frame.Size = UDim2.fromOffset(state.w, state.h)
        frame.Active = true
        frame.Parent = mobileGui

        local corner = Instance.new('UICorner')
        corner.CornerRadius = UDim.new(0.18, 0)
        corner.Parent = frame

        local label = Instance.new('TextLabel')
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Text = def.label
        label.ZIndex = 11
        label.Parent = frame

        local handle = Instance.new('Frame')
        handle.Size = UDim2.fromOffset(18, 18)
        handle.Position = UDim2.new(1, -18, 1, -18)
        handle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        handle.BackgroundTransparency = 0.5
        handle.BorderSizePixel = 0
        handle.ZIndex = 12
        handle.Active = true
        handle.Parent = frame
        do
            local hc = Instance.new('UICorner')
            hc.CornerRadius = UDim.new(0.3, 0)
            hc.Parent = handle
        end

        local function clampPos(x, y)
            return math.clamp(x, 0, screen.X - state.w), math.clamp(y, 0, screen.Y - state.h)
        end

        local function setVisual(active)
            frame.BackgroundTransparency = active and 0.05 or 0.4
        end

        local function fireAction()
            if def.kind == 'toggle' then
                state.on = not state.on
                setVisual(state.on)
                if def.id == 'esp' then
                    Settings.ESP = state.on
                    syncComp(UIComps.esp, state.on)
                    scheduleSave()
                elseif def.id == 'nc' then
                    Settings.Noclip = state.on
                    if state.on then enableNoclip() else disableNoclip() end
                    syncComp(UIComps.noclip, state.on)
                    scheduleSave()
                end
            elseif def.kind == 'hold' then
                if def.id == 'aim' then aimlockHeld = true end
                if def.id == 'spd' then speedHeld = true end
                setVisual(true)
            elseif def.kind == 'menu' then
                local done = pcall(function() Window:Toggle() end)
                if not done then
                    for _, g in ipairs(windowGuis) do
                        pcall(function() g.Enabled = not g.Enabled end)
                    end
                end
            end
        end

        local function releaseAction()
            if def.kind == 'hold' then
                if def.id == 'aim' then aimlockHeld = false end
                if def.id == 'spd' then speedHeld = false end
                setVisual(false)
            end
        end

        frame.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            if not state.dragging then
                state.dragging = true
                state.dragId = input
                state.offX = input.Position.X - state.x
                state.offY = input.Position.Y - state.y
                state.moved = 0
            end
            if def.kind == 'hold' then fireAction() end
        end)

        frame.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            if state.dragging and input == state.dragId then
                state.moved = state.moved
                    + math.abs(input.Position.X - (state.x + state.offX))
                    + math.abs(input.Position.Y - (state.y + state.offY))
                state.x, state.y = clampPos(input.Position.X - state.offX, input.Position.Y - state.offY)
                frame.Position = UDim2.fromOffset(state.x, state.y)
            end
        end)

        frame.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            if state.dragging and input == state.dragId then
                state.dragging = false
                state.dragId = nil
                if state.moved < 12 then
                    if def.kind == 'toggle' or def.kind == 'menu' then
                        fireAction()
                    end
                end
            end
            releaseAction()
        end)

        local rId = nil
        local rStartX, rStartW = 0, 0
        handle.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            if rId then return end
            rId = input
            rStartX = input.Position.X
            rStartW = state.w
        end)
        handle.InputChanged:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Touch then return end
            if input ~= rId then return end
            local delta = input.Position.X - rStartX
            state.w = math.clamp(rStartW + delta, MIN_SIZE, MAX_SIZE)
            state.h = state.w
            frame.Size = UDim2.fromOffset(state.w, state.h)
        end)
        handle.InputEnded:Connect(function(input)
            if input == rId then rId = nil end
        end)

        if def.id == 'esp' then
            state.on = Settings.ESP
            setVisual(state.on)
        elseif def.id == 'nc' then
            state.on = Settings.Noclip
            setVisual(state.on)
        end
    end

    for _, def in ipairs(defs) do makeButton(def) end
end

-- ══════════════ pc input — no gameProcessed guard ══════════════
-- combat inputs are game-processed by definition (RMB = scope); the old
-- guard silently ate the aim key. chat text can trigger letter binds —
-- that's the trade every combat script makes.

local function toggleWindow()
    local done = false
    if Window then done = pcall(function() Window:Toggle() end) end
    if not done then
        for _, g in ipairs(windowGuis) do
            pcall(function() g.Enabled = not g.Enabled end)
        end
    end
end

table.insert(connections, UserInputService.InputBegan:Connect(function(input)
    if pickerCount > 0 then return end   -- a keybind picker is listening

    if Settings.MenuKey and inputMatches(input, Settings.MenuKey) then
        -- the library owns libKey for this session (set at window creation);
        -- handling it here too would double-toggle. next boot uses the new key.
        if Settings.MenuKey ~= libKey then
            toggleWindow()
        end
        return
    end

    if Settings.NoclipKey and inputMatches(input, Settings.NoclipKey) then
        Settings.Noclip = not Settings.Noclip
        if Settings.Noclip then enableNoclip() else disableNoclip() end
        syncComp(UIComps.noclip, Settings.Noclip)
        scheduleSave()
        return
    end

    if Settings.AimKey and inputMatches(input, Settings.AimKey) then
        aimHeld = true
        return
    end
end))

table.insert(connections, UserInputService.InputEnded:Connect(function(input)
    if Settings.AimKey and inputMatches(input, Settings.AimKey) then
        aimHeld = false
    end
end))
