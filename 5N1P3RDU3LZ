-- ══════════════ noclip ══════════════

local noclipConn = nil

local function enableNoclip()
    if noclipConn then return end
    noclipConn = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA('BasePart') and p.CanCollide then
                p.CanCollide = false
            end
        end
    end)
end

local function disableNoclip()
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA('BasePart') then pcall(function() p.CanCollide = true end) end
        end
    end
end

-- ══════════════ speed ══════════════

local speedDefault, speedActive = nil, false

local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass('Humanoid')
end

local function applySpeed()
    local hum = getHumanoid()
    if not hum then return end
    if not speedActive then
        speedDefault = hum.WalkSpeed
        speedActive = true
    end
    hum.WalkSpeed = Settings.SpeedValue
end

local function restoreSpeed()
    if not speedActive then return end
    speedActive = false
    local hum = getHumanoid()
    if hum and speedDefault then hum.WalkSpeed = speedDefault end
    speedDefault = nil
end

table.insert(connections, LocalPlayer.CharacterAdded:Connect(function()
    speedActive = false
    speedDefault = nil
end))

-- ══════════════ main render loop ══════════════

table.insert(connections, RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local VP = cam.ViewportSize
    local center = Vector2.new(VP.X / 2, VP.Y / 2)

    -- speed (E hold / SPD button)
    local held = Settings.Speed and (UserInputService:IsKeyDown(Enum.KeyCode.E) or speedHeld)
    if held and not speedActive then
        applySpeed()
    elseif not held and speedActive then
        restoreSpeed()
    elseif held and speedActive then
        local hum = getHumanoid()
        if hum then hum.WalkSpeed = Settings.SpeedValue end
    end

    -- esp: visible-set tracking so dead/gone players' boxes hide instead
    -- of freezing on screen
    if HAS_DRAWING then
        local visible = {}
        if Settings.ESP then
            for plr, b in pairs(BoundsCache) do
                if b and (Settings.ESPMaxDist <= 0 or (b.dist or 0) <= Settings.ESPMaxDist) then
                    visible[plr] = true
                    local d = espEnsure(plr)

                    if Settings.ESPBox then
                        local segs = {
                            {Vector2.new(b.tl.X, b.tl.Y), Vector2.new(b.br.X, b.tl.Y)},
                            {Vector2.new(b.br.X, b.tl.Y), Vector2.new(b.br.X, b.br.Y)},
                            {Vector2.new(b.br.X, b.br.Y), Vector2.new(b.tl.X, b.br.Y)},
                            {Vector2.new(b.tl.X, b.br.Y), Vector2.new(b.tl.X, b.tl.Y)},
                        }
                        for i, seg in ipairs(segs) do
                            d.box[i].From = seg[1]
                            d.box[i].To = seg[2]
                            d.box[i].Visible = true
                        end
                    else
                        for _, l in ipairs(d.box) do l.Visible = false end
                    end

                    if Settings.ESPName then
                        d.name.Text = string.format('%s [%dm]', plr.DisplayName, math.floor(b.dist or 0))
                        d.name.Position = Vector2.new(b.cx, b.tl.Y - 16)
                        d.name.Visible = true
                    else
                        d.name.Visible = false
                    end

                    if Settings.ESPHealth and b.hp then
                        local pct = math.clamp(b.hp / math.max(b.max, 1), 0, 1)
                        local barW, barX = 4, b.tl.X - 7
                        d.hpBG.Position = Vector2.new(barX, b.tl.Y)
                        d.hpBG.Size = Vector2.new(barW, b.h)
                        d.hpBG.Visible = true
                        d.hpFill.Position = Vector2.new(barX, b.tl.Y + b.h * (1 - pct))
                        d.hpFill.Size = Vector2.new(barW, b.h * pct)
                        d.hpFill.Color = Color3.fromRGB(math.floor(255 * (1 - pct)), math.floor(255 * pct), 0)
                        d.hpFill.Visible = true
                    else
                        d.hpBG.Visible = false
                        d.hpFill.Visible = false
                    end

                    if Settings.ESPTracer then
                        d.tracer.From = Vector2.new(VP.X / 2, VP.Y)
                        d.tracer.To = Vector2.new(b.cx, b.cy)
                        d.tracer.Visible = true
                    else
                        d.tracer.Visible = false
                    end
                end
            end
        end
        for plr, d in pairs(espObjects) do
            if not visible[plr] then espHide(d) end
        end
    else
        hlUpdate()
    end

    -- fov circle
    if fovCircle then
        if Settings.ShowFOV and Settings.Aimbot then
            fovCircle.Position = center
            fovCircle.Radius = Settings.FOV
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end
    end

    -- mouse aim engine
    if Settings.AimEngine == 'Mouse' and HAS_MOUSEMOVE and aimActive() then
        local part = getAimTarget(cam, center)
        if part then
            local sp = cam:WorldToViewportPoint(part.Position)
            if sp.Z > 0 then
                local f = Settings.MouseFactor / 100
                pcall(mousemoverel, (sp.X - center.X) * f, (sp.Y - center.Y) * f)
            end
        end
    end
end))

table.insert(connections, Players.PlayerRemoving:Connect(function(plr)
