-- ══════════════ settings ══════════════

local CONFIG_PATH = 'ZkxHub/SniperDuels.json'

local Settings = {
    ESP = true, ESPBox = true, ESPName = true, ESPHealth = true, ESPTracer = false,
    ESPMaxDist = 500, TeamCheck = true,
    Aimbot = false, AimEngine = 'Camera',
    TargetPart = 'Head', VisibleCheck = true, ShowFOV = true,
    FOV = 130, Smoothing = 4, MouseFactor = 18,
    Noclip = false, Speed = true, SpeedValue = 60,
    MenuKey = Enum.KeyCode.RightShift,
    AimKey = Enum.UserInputType.MouseButton2,
    NoclipKey = Enum.KeyCode.V,
}

do
    if type(isfile) == 'function' and type(readfile) == 'function' and isfile(CONFIG_PATH) then
        local ok, data = pcall(readfile, CONFIG_PATH)
        if ok and type(data) == 'string' then
            local ok2, tbl = pcall(function() return HttpService:JSONDecode(data) end)
            if ok2 and type(tbl) == 'table' then
                for k, v in pairs(tbl) do
                    if Settings[k] ~= nil and type(v) == type(Settings[k]) then
                        Settings[k] = v
                    end
                end
                if type(tbl.MenuKeyCode) == 'string' then
                    local kc = Enum.KeyCode[tbl.MenuKeyCode]
                    if kc then Settings.MenuKey = kc end
                end
                if type(tbl.AimKeyInput) == 'string' then
                    local okD, key = pcall(function()
                        if tbl.AimKeyInput:sub(1, 6) == 'MouseB' then
                            return Enum.UserInputType[tbl.AimKeyInput]
                        end
                        return Enum.KeyCode[tbl.AimKeyInput]
                    end)
                    if okD and key then Settings.AimKey = key end
                end
                if type(tbl.NoclipKeyCode) == 'string' then
                    local kc = Enum.KeyCode[tbl.NoclipKeyCode]
                    if kc then Settings.NoclipKey = kc end
                end
            end
        end
    end
end
if IsMobile then Settings.AimEngine = 'Camera' end

local saveToken = 0
local function scheduleSave()
    saveToken = saveToken + 1
    local my = saveToken
    task.delay(1.5, function()
        if saveToken ~= my or type(writefile) ~= 'function' then return end
        local out = {}
        for k, v in pairs(Settings) do out[k] = v end
        out.MenuKey = nil
        out.AimKey = nil
        out.NoclipKey = nil
        out.MenuKeyCode = tostring(Settings.MenuKey and Settings.MenuKey.Name or Settings.MenuKey)
        out.AimKeyInput = tostring(Settings.AimKey and Settings.AimKey.Name or Settings.AimKey)
        out.NoclipKeyCode = tostring(Settings.NoclipKey and Settings.NoclipKey.Name or Settings.NoclipKey)
        local ok, json = pcall(function() return HttpService:JSONEncode(out) end)
        if not ok then return end
        pcall(function()
            if type(isfolder) == 'function' and not isfolder('ZkxHub')
                and type(makefolder) == 'function' then
                makefolder('ZkxHub')
            end
            writefile(CONFIG_PATH, json)
        end)
    end)
end

-- ══════════════ input helpers ══════════════

local function describeInput(key)
    if typeof(key) == 'EnumItem' then return tostring(key.Name) end
    return tostring(key)
end

local function inputMatches(input, key)
    if key == nil then return false end
    if typeof(key) == 'EnumItem' and key.EnumType == Enum.UserInputType then
        return input.UserInputType == key
    end
    return input.KeyCode == key
end

-- ══════════════ team system — learned from the game's own traffic ══════════════
-- no roblox Teams in this game. three sources, in trust order:
--   1. Match.NewMatch arg4: { [teamIdx] = { [slot] = {u=userid, pl=player, pt=...} } }
--   2. PadMatchmakingUpdate: CurrentTeams = { MyTeam={players}, EnemyTeam={players} }
--   3. KillFeed(killer, victim): server-confirmed ENEMY pairs (no friendly fire)
-- isTeammate falls back through whatever is known.

local myTeamIndex  = nil     -- from NewMatch
local playerTeam   = {}      -- [player] = team index (NewMatch) or 'my'/'enemy' (pad)
local enemyPair    = {}      -- [player] = { [otherPlayer] = true } confirmed enemies

local function resolvePlayer(ref, userid)
    if typeof(ref) == 'Instance' and ref:IsA('Player') then return ref end
    if userid then
        local p = Players:GetPlayerByUserId(userid)
        if p then return p end
    end
    if type(ref) == 'string' then
        return Players:FindFirstChild(ref)
    end
    if type(ref) == 'number' then
        return Players:GetPlayerByUserId(ref)
    end
    return nil
end

local function noteEnemyPair(a, b)
    if not (a and b) or a == b then return end
    enemyPair[a] = enemyPair[a] or {}
    enemyPair[a][b] = true
    enemyPair[b] = enemyPair[b] or {}
    enemyPair[b][a] = true
end

local function clearTeamData()
    myTeamIndex = nil
    table.clear(playerTeam)
    table.clear(enemyPair)
end

do
    local matchFolder = ReplicatedStorage.Remotes:FindFirstChild('Match')
    if matchFolder then
        -- source 1: NewMatch rosters (authoritative)
        local newMatch = matchFolder:FindFirstChild('NewMatch')
        if newMatch and newMatch:IsA('RemoteEvent') then
            newMatch.OnClientEvent:Connect(function(_, _, _, teams)
                if type(teams) ~= 'table' then return end
                clearTeamData()
                for teamIdx, roster in pairs(teams) do
                    if type(roster) == 'table' then
                        for _, entry in pairs(roster) do
                            if type(entry) == 'table' then
                                local plr = resolvePlayer(entry.pl, entry.u)
                                if plr == LocalPlayer then
                                    myTeamIndex = teamIdx
                                elseif plr then
                                    playerTeam[plr] = teamIdx
                                end
                            end
                        end
                    end
                end
            end)
        end

        -- source 2: pad matchmaking — MyTeam/EnemyTeam while queueing
        local padUpdate = matchFolder:FindFirstChild('PadMatchmakingUpdate')
        if padUpdate and padUpdate:IsA('RemoteEvent') then
            padUpdate.OnClientEvent:Connect(function(data)
                if type(data) ~= 'table' then return end
                local ct = data.CurrentTeams
                if type(ct) ~= 'table' then return end
                if myTeamIndex ~= nil then return end   -- NewMatch outranks pads
                table.clear(playerTeam)
                if type(ct.MyTeam) == 'table' then
                    for _, plr in pairs(ct.MyTeam) do
                        if typeof(plr) == 'Instance' and plr:IsA('Player') and plr ~= LocalPlayer then
                            playerTeam[plr] = 'my'
                        end
                    end
                end
                if type(ct.EnemyTeam) == 'table' then
                    for _, plr in pairs(ct.EnemyTeam) do
                        if typeof(plr) == 'Instance' and plr:IsA('Player') then
                            playerTeam[plr] = 'enemy'
                            noteEnemyPair(LocalPlayer, plr)
                        end
                    end
                end
            end)
        end

        -- source 3: killfeed — confirmed enemy pairs
        local killFeed = matchFolder:FindFirstChild('KillFeed')
        if killFeed and killFeed:IsA('RemoteEvent') then
            killFeed.OnClientEvent:Connect(function(killer, victim)
                noteEnemyPair(resolvePlayer(killer), resolvePlayer(victim))
            end)
        end
    end
end

local function isTeammate(plr)
    if not Settings.TeamCheck then return false end
    -- NewMatch data: same team index
    if myTeamIndex ~= nil then
        return playerTeam[plr] == myTeamIndex
    end
    -- pad data: explicit my/enemy
    local t = playerTeam[plr]
    if t == 'my' then return true end
    if t == 'enemy' then return false end
    -- killfeed: confirmed enemies are NOT teammates; unknowns treated as enemy
    return false
end

-- ══════════════ targeting ══════════════

local function isVisible(part, cam)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then exclude[#exclude + 1] = p.Character end
    end
    params.FilterDescendantsInstances = exclude
    return workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, params) == nil
end

-- ══════════════ esp bounds — corner projection ══════════════

local PARTS = {
    'Head','UpperTorso','LowerTorso','HumanoidRootPart',
    'LeftUpperArm','RightUpperArm','LeftLowerArm','RightLowerArm',
    'LeftHand','RightHand','LeftUpperLeg','RightUpperLeg',
    'LeftLowerLeg','RightLowerLeg','LeftFoot','RightFoot',
    'Torso','Left Arm','Right Arm','Left Leg','Right Leg',
}
local CUBE = {
    Vector3.new( 1, 1, 1), Vector3.new(-1, 1, 1),
    Vector3.new( 1,-1, 1), Vector3.new(-1,-1, 1),
    Vector3.new( 1, 1,-1), Vector3.new(-1, 1,-1),
    Vector3.new( 1,-1,-1), Vector3.new(-1,-1,-1),
}

local BoundsCache = {}

local function computeBounds(cam, char)
    local minX, minY, maxX, maxY = 1e9, 1e9, -1e9, -1e9
    local any = false
    for _, name in ipairs(PARTS) do
        local part = char:FindFirstChild(name)
        if part and part:IsA('BasePart') then
            local cf = part.CFrame
            local hx, hy, hz = part.Size.X * 0.5, part.Size.Y * 0.5, part.Size.Z * 0.5
            for _, c in ipairs(CUBE) do
                local sp = cam:WorldToViewportPoint(cf * Vector3.new(hx * c.X, hy * c.Y, hz * c.Z))
                if sp.Z > 0 then
                    any = true
                    if sp.X < minX then minX = sp.X end
                    if sp.Y < minY then minY = sp.Y end
                    if sp.X > maxX then maxX = sp.X end
                    if sp.Y > maxY then maxY = sp.Y end
                end
            end
        end
    end
    if not any then return nil end
    return {
        tl = Vector2.new(minX, minY), br = Vector2.new(maxX, maxY),
        w = maxX - minX, h = maxY - minY,
        cx = (minX + maxX) * 0.5, cy = (minY + maxY) * 0.5,
    }
end

table.insert(connections, RunService.Heartbeat:Connect(function()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local camPos = cam.CFrame.Position
    local seen = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isTeammate(plr) then
            seen[plr] = true
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass('Humanoid')
            local hrp = char and char:FindFirstChild('HumanoidRootPart')
            if char and hum and hum.Health > 0 and hrp then
                local b = computeBounds(cam, char)
                if b then
                    b.dist = (camPos - hrp.Position).Magnitude
                    b.hp = hum.Health
                    b.max = hum.MaxHealth
                end
                BoundsCache[plr] = b
            else
                BoundsCache[plr] = nil
            end
        end
    end
    for plr in pairs(BoundsCache) do
        if not seen[plr] then BoundsCache[plr] = nil end
    end
end))

-- ══════════════ esp — drawing path ══════════════

local espObjects = {}

local function espHide(d)
    for _, l in ipairs(d.box) do l.Visible = false end
    d.name.Visible = false
    d.hpBG.Visible = false
    d.hpFill.Visible = false
    d.tracer.Visible = false
end

local function espRemove(plr)
    local d = espObjects[plr]
    if not d then return end
    for _, l in ipairs(d.box) do pcall(function() l:Remove() end) end
    pcall(function() d.name:Remove() end)
    pcall(function() d.hpBG:Remove() end)
    pcall(function() d.hpFill:Remove() end)
    pcall(function() d.tracer:Remove() end)
    espObjects[plr] = nil
end

local function espEnsure(plr)
    local d = espObjects[plr]
    if d then return d end
    d = { box = {}, name = Drawing.new('Text'), hpBG = Drawing.new('Square'),
          hpFill = Drawing.new('Square'), tracer = Drawing.new('Line') }
    for i = 1, 4 do
        local l = Drawing.new('Line')
        l.Thickness = 1.5
        l.Color = Color3.fromRGB(255, 80, 80)
        d.box[i] = l
    end
    d.name.Size = 13
    d.name.Center = true
    d.name.Outline = true
    d.name.Color = Color3.fromRGB(255, 255, 255)
    d.hpBG.Filled = true
    d.hpBG.Color = Color3.fromRGB(0, 0, 0)
    d.hpBG.Transparency = 0.5
    d.hpFill.Filled = true
    d.tracer.Thickness = 1
    d.tracer.Color = Color3.fromRGB(255, 200, 0)
    espObjects[plr] = d
    return d
end

-- ══════════════ esp — highlight fallback (no Drawing API) ══════════════

local highlights = {}

local function hlRemove(plr)
    local hl = highlights[plr]
    if hl then pcall(function() hl:Destroy() end) highlights[plr] = nil end
end

local function hlUpdate()
    for plr, hl in pairs(highlights) do
        local b = BoundsCache[plr]
        local show = Settings.ESP and b ~= nil
            and (Settings.ESPMaxDist <= 0 or (b.dist or 0) <= Settings.ESPMaxDist)
        hl.Enabled = show == true
        if show then hl.Adornee = plr.Character end
    end
    if Settings.ESP then
        for plr, b in pairs(BoundsCache) do
            if b and not highlights[plr]
                and (Settings.ESPMaxDist <= 0 or (b.dist or 0) <= Settings.ESPMaxDist) then
                local hl = Instance.new('Highlight')
                hl.FillColor = Color3.fromRGB(255, 60, 60)
                hl.FillTransparency = 0.6
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee = plr.Character
                hl.Enabled = true
                local ok = pcall(function() hl.Parent = game:GetService('CoreGui') end)
                if not ok then hl.Parent = LocalPlayer:WaitForChild('PlayerGui') end
                highlights[plr] = hl
            end
        end
    end
end

-- ══════════════ aim ══════════════

local aimHeld     = false   -- pc aim key held
local aimlockHeld = false   -- mobile AIM button held
local speedHeld   = false   -- mobile SPD button held

local function aimActive()
    return Settings.Aimbot == true and (aimHeld or aimlockHeld)
end

local function getAimTarget(cam, center)
    local best, bestDist = nil, math.huge
    for plr, b in pairs(BoundsCache) do
        if b then
            local dist = (Vector2.new(b.cx, b.cy) - center).Magnitude
            if dist <= Settings.FOV and dist < bestDist then
                local char = plr.Character
                local part = char and (char:FindFirstChild(Settings.TargetPart)
                    or char:FindFirstChild('HumanoidRootPart'))
                if part and (not Settings.VisibleCheck or isVisible(part, cam)) then
                    best, bestDist = part, dist
                end
            end
        end
    end
    return best
end

-- camera engine: Last priority so the game's own camera code writes first
-- and ours lands on top of the final frame
RunService:BindToRenderStep('ZkxHubSDAim', Enum.RenderPriority.Last.Value, function()
    if Settings.AimEngine ~= 'Camera' or not aimActive() then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local part = getAimTarget(cam, center)
    if not part then return end
    local alpha = math.clamp(1 / math.max(Settings.Smoothing, 1), 0.02, 1)
    pcall(function()
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, part.Position), alpha)
    end)
end)

